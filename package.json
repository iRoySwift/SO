{
  "name": "so",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "check:expo": "expo install --check",
    "start": "expo start",
    "android": "expo run:android --device",
    "ios": "expo run:ios --device",
    "ios:provision": "xcodebuild -workspace ios/SO.xcworkspace -scheme SO -configuration Debug -destination generic/platform=iOS -allowProvisioningUpdates -allowProvisioningDeviceRegistration build",
    "web": "expo start --web",
    "lint": "expo lint",
    "prepare": "husky"
  },
  "dependencies": {
    "@expo-google-fonts/urbanist": "^0.4.2",
    "@shopify/react-native-skia": "2.6.2",
    "expo": "^57.0.7",
    "expo-constants": "~57.0.6",
    "expo-dev-client": "~57.0.7",
    "expo-device": "~57.0.1",
    "expo-font": "~57.0.1",
    "expo-glass-effect": "~57.0.1",
    "expo-haptics": "~57.0.1",
    "expo-image": "~57.0.1",
    "expo-linear-gradient": "~57.0.1",
    "expo-linking": "~57.0.3",
    "expo-router": "~57.0.7",
    "expo-splash-screen": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.1",
    "expo-system-ui": "~57.0.1",
    "expo-web-browser": "~57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.0",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "4.25.2",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.0"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~57.0.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "husky": "^9.1.7",
    "typescript": "~6.0.3"
  },
  "private": true
}
